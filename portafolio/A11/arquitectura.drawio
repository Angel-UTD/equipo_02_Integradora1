ida()&lt;br&gt;tiempo_instancia()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="290" width="200" height="120" as="geometry"/></mxCell><mxCell id="b2" value="Reconocimiento facial&lt;br&gt;OpenCV (opencv-contrib-python)&lt;br&gt;+ pillow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="200" height="120" as="geometry"/></mxCell><mxCell id="b3" value="Clase Empleados&lt;br&gt;agregar() · consultar()&lt;br&gt;modificar() · eliminar()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="290" width="215" height="120" as="geometry"/></mxCell><mxCell id="b4" value="Exportación de reportes&lt;br&gt;Excel con openpyxl&lt;br&gt;PDF: librería por decidir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="290" width="215" height="120" as="geometry"/></mxCell><mxCell id="d1" value="MariaDB en contenedor Docker&lt;br&gt;bd_asistencias: personal, checados&lt;br&gt;usuario asistencia_app · puerto 3307 (3306 es de XAMPP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="540" width="330" height="110" as="geometry"/></mxCell><mxCell id="d2" value="Carpeta de rostros&lt;br&gt;(fotos en disco de la laptop,&lt;br&gt;NO van en la base de datos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="540" width="300" height="110" as="geometry"/></mxCell><mxCell id="e0" value="usa" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;" edge="1" parent="1" source="a1" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="